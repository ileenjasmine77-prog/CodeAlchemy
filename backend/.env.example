# Hindsight
# Cloud:   https://api.hindsight.vectorize.io  (+ HINDSIGHT_API_KEY from the Connect page)
# Local:   http://localhost:8888               (no key needed by default)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# Bank (namespace) that all incidents are stored/recalled under
HINDSIGHT_BANK_ID=soc-account-takeover

# Groq (LLM reasoning)
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b
